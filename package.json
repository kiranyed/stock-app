{
  "name": "stock-trading-app",
  "version": "1.0.0",
  "description": "Trade stocks",
  "main": "src/start.js",
  "scripts": {
    "start": "npm install --only=prod && NODE_ENV=production node ./build/startup/start.js",
    "start-dev": "nodemon --config \"./util/nodemon.json\"/",
    "set-access-token": "node ./util/set-access-token.mjs",
    "test": "jest",
    "build": "sh ./util/buildForProd.sh",
    "lint": "eslint . --ext .ts",
    "liquibase-update": "ts-node db/liquibase.ts update",
    "liquibase-scorch": "ts-node db/liquibase.ts scorch",
    "liquibase-scorch-and-update": "npm run liquibase-scorch && npm run liquibase-update",
    "liquibase-clear-checksums": "ts-node db/liquibase.ts clearCheckSums"
  },
  "keywords": [
    "TypeScript",
    "Express",
    "React",
    "FullStack"
  ],
  "author": "Kiran",
  "license": "ISC",
  "dependencies": {
    "@allensarkisyan/schwab-td-ameritrade-streamer": "^1.0.0",
    "@jest-mock/express": "^3.0.0",
    "@polygon.io/client-js": "^8.2.0",
    "axios": "^1.15.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "moment-timezone": "^0.6.1",
    "mysql2": "^3.22.2",
    "node-liquibase": "^4.3.3",
    "node-schedule": "^2.1.1",
    "schwab-client-js": "^1.1.3",
    "selenium-webdriver": "^4.43.0",
    "technicalindicators": "^3.1.0",
    "twilio": "^6.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/node": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/node-schedule": "^2.1.8",
    "@types/selenium-webdriver": "^4.35.5",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  }
}
