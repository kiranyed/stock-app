{
  "name": "stock-trading-app",
  "version": "1.0.0",
  "description": "Trade stocks",
  "main": "src/start.js",
  "scripts": {
    "start": "npm install --only=prod && NODE_ENV=production node ./build/startup/start.js",
    "start-dev": "nodemon --config \"./util/nodemon.json\"/",
    "schwab-login": "ts-node src/startup/schwab-login.ts",
    "mcp": "ts-node src/mcp/main.ts",
    "test": "jest && TZ=UTC jest src/tests/back-test/back-test-helper.characterization.test.ts",
    "build": "sh ./util/buildForProd.sh",
    "lint": "eslint . --ext .ts",
    "liquibase-update": "ts-node db/liquibase.ts update",
    "liquibase-scorch": "ts-node db/liquibase.ts scorch",
    "liquibase-scorch-and-update": "npm run liquibase-scorch && npm run liquibase-update",
    "liquibase-clear-checksums": "ts-node db/liquibase.ts clearCheckSums",
    "load-test:schema": "ts-node util/load-test/create-schema.ts",
    "load-test:record": "ts-node util/load-test/record-candles.ts",
    "load-test:server": "ts-node util/load-test/server.ts",
    "load-test": "ts-node util/load-test/load-test.ts"
  },
  "keywords": [
    "TypeScript",
    "Express",
    "React",
    "FullStack"
  ],
  "author": "Kiran",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "axios": "^1.15.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.2.1",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.22.2",
    "node-liquibase": "^4.3.3",
    "tslib": "^2.8.1",
    "twilio": "^6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "technicalindicators": "^3.1.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
