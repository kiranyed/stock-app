{
  "compileOnSave": true,
  "compilerOptions": {
    "esModuleInterop": true,
    "noImplicitAny": true,
    "module": "commonjs",
    "strict": true,
    "rootDir": "src",
    "outDir": "build",
    "sourceMap": true,
    "removeComments": true,
    "target": "ES2020",
    "importHelpers": true,
    "types": [
      "node",
      "jest"
    ],
    "typeRoots": [
      "node_modules/@types",
      "src/types"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/tests/**/*.ts"],
  "exclude": [
    "node_modules",
    "src/public/"
  ]
}